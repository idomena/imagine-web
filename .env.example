# ── API ───────────────────────────────────────────────────────────────────────
# Public — baked into the browser bundle at build time. Must be set BEFORE deploy.
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# Server-only — Railway internal network (faster, stays inside Railway).
# Set to: http://appmarket-api.railway.internal:3000
# Leave blank if not using Railway internal networking.
INTERNAL_API_URL=

# ── Google OAuth (NextAuth) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-random-32-chars
NEXTAUTH_URL=https://your-app.vercel.app
